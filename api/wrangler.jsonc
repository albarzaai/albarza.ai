{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albarza-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "api.albarza.ai", "custom_domain": true }],
  "vars": { "ALLOWED_ORIGINS": "https://albarza.ai,https://www.albarza.ai" },
  // Secrets, set with `wrangler secret put`: GEMINI_API_KEY, INTERNAL_AUTH_SECRET.
  "ratelimits": [
    { "name": "GENERATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "GLOBAL_LIMIT", "namespace_id": "2002", "simple": { "limit": 100, "period": 60 } }
  ]
}
