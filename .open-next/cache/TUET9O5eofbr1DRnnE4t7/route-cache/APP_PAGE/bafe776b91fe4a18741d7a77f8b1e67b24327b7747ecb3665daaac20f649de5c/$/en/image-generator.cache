iv\",null,{\"className\":\"mt-10 divide-y divide-line border-y border-line\",\"children\":[[\"$\",\"details\",\"What is Albarza's AI video generator?\",{\"className\":\"group py-5\",\"open\":true,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"What is Albarza's AI video generator?\",[\"$\",\"span\",null,{\"className\":\"text-gold transition group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-7 text-muted\",\"children\":\"Albarza's AI Video Generator turns text prompts and images into short video clips and lets you compare multiple video models in one workspace. Start with a clear brief, generate a first result, and refine the detail that needs improvement.\"}]]}],[\"$\",\"details\",\"How do I generate a video from an image?\",{\"className\":\"group py-5\",\"open\":false,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"How do I generate a video from an image?\",[\"$\",\"span\",null,{\"className\":\"text-gold transition group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-7 text-muted\",\"children\":\"Upload a photo or choose an image from your previous sessions, add a text prompt, adjust your settings, and click Generate. You can control the start and end frames of each clip. A short, specific prompt is usually enough for a clean first result.\"}]]}],[\"$\",\"details\",\"Can I use AI-generated videos in commercial projects?\",{\"className\":\"group py-5\",\"open\":false,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"Can I use AI-generated videos in commercial projects?\",[\"$\",\"span\",null,{\"className\":\"text-gold transition group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-7 text-muted\",\"children\":\"Yes, as long as they comply with Albarza's Terms of Use and UAE law. Use cases include client work, social media content, ads, and marketing campaigns.\"}]]}],[\"$\",\"details\",\"What rights do I have over AI-generated videos?\",{\"className\":\"group py-5\",\"open\":false,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"What rights do I have over AI-generated videos?\",[\"$\",\"span\",null,{\"className\":\"text-gold transition group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-7 text-muted\",\"children\":\"You keep full rights to the videos you create. You are free to use, modify, distribute, and monetize them, subject to the License and Terms of Use. Albarza does not claim ownership of your generated content.\"}]]}],[\"$\",\"details\",\"Are my video outputs used to train AI models?\",{\"className\":\"group py-5\",\"open\":false,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"Are my video outputs used to train AI models?\",[\"$\",\"span\",null,{\"className\":\"text-gold transition group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-7 text-muted\",\"children\":\"No. Albarza does not use your prompts, uploads, or generated videos to train AI models. All outputs are private and protected under strict security standards and the UAE PDPL.\"}]]}],[\"$\",\"details\",\"What AI video models are available?\",{\"className\":\"group py-5\",\"open\":false,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"What AI video models are available?