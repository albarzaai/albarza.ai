{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/(site)/layout,_N_T_/[locale]/(site)/image-generator/layout,_N_T_/[locale]/(site)/image-generator/page,_N_T_/ar/image-generator"},"segmentPaths":["/_tree","/_full","/$d$locale/!KHNpdGUp","/$d$locale/!KHNpdGUp/image-generator/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":32,"slots":{"children":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/bafe776b91fe4a18741d7a77f8b1e67b24327b7747ecb3665daaac20f649de5c/$/ar/image-generator","owner":{"kind":"APP_PAGE","sourceRoute":"/[locale]/(site)/image-generator/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"ar\" dir=\"rtl\" class=\"_0bjUvq_variable hHfarW_variable\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/07c7676b89ed2778-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/f5e6f786bcaa2be4-s.p.30d2r2x65bwdm.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/media/hero.svg\" as=\"image\" fetchPriority=\"high\"/><link rel=\"preload\" href=\"/brand/logo.svg\" as=\"image\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/17tymn_qegvh9.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1x6obpmlu1_c2.js\"/><script src=\"/_next/static/chunks/2r4s4h5xul1n-.js\" async=\"\"></script><script src=\"/_next/static/chunks/3wbm-994r45kr.js\" async=\"\"></script><script src=\"/_next/static/chunks/2e268anpfvdoc.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3-ry682tkyiqk.js\" async=\"\"></script><script src=\"/_next/static/chunks/0umf92h1sb77c.js\" async=\"\"></script><script src=\"/_next/static/chunks/2n5qeheznvl4u.js\" async=\"\"></script><script src=\"/_next/static/chunks/1_miqk4gqcfj7.js\" async=\"\"></script><title>البرزة — أفضل مولّد فيديو بالذكاء الاصطناعي للمبدعين</title><meta name=\"description\" content=\"أنشئ فيديوهات سينمائية عالية الجودة من النصوص أو الصور المرجعية باستخدام أحدث النماذج.\"/><link rel=\"icon\" href=\"/brand/logo.svg\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><header class=\"absolute inset-x-0 top-0 z-40\"><div class=\"flex h-[76px] items-center justify-between px-5 md:px-10\"><div class=\"flex items-center gap-12\"><a class=\"flex items-center gap-2.5\" href=\"/ar\"><img src=\"/brand/logo.svg\" alt=\"\" width=\"26\" height=\"32\"/><span class=\"text-lg font-bold tracking-wide\">البرزة</span></a><nav class=\"hidden items-center gap-8 text-sm font-medium lg:flex\"><a class=\"flex items-center gap-1 hover:text-gold-hi\" href=\"/ar/image-generator\">صور الذكاء الاصطناعي<svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\"></path></svg></a><a class=\"flex items-center gap-1 hover:text-gold-hi\" href=\"/ar/video-generator/veo-3-1\">فيديو الذكاء الاصطناعي<svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\"></path></svg></a><a class=\"flex items-center gap-1 hover:text-gold-hi\" href=\"/ar/signup\">المحرر</a><a class=\"flex items-center gap-1 hover:text-gold-hi\" href=\"/ar/signup\">استكشف</a><a class=\"flex items-center gap-1 hover:text-gold-hi\" href=\"/ar/signup\">القوالب</a></nav></div><div class=\"flex items-center gap-5 text-sm font-medium\"><a hrefLang=\"en\" class=\"text-white/80 hover:text-white\" href=\"/en\">English</a><a class=\"hidden hover:text-gold-hi sm:block\" href=\"/ar/pricing\">الأسعار</a><a class=\"hover:text-gold-hi\" href=\"/ar/login\">تسجيل الدخول</a><a class=\"btn btn-gold !px-6\" href=\"/ar/signup\">إنشاء حساب</a></div></div></header><main><section class=\"relative flex min-h-[100svh] items-end justify-center overflow-hidden\"><img src=\"/media/hero.svg\" alt=\"\" fetchPriority=\"high\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/70\"></div><nav aria-label=\"breadcrumb\" class=\"absolute start-10 top-[112px] z-10 hidden text-sm text-white/80 md:block\"><a href=\"/ar\">الرئيسية</a> <span class=\"px-1\">/</span> <span class=\"text-white\">صور الذكاء الاصطناعي</span></nav><div class=\"relative z-10 mx-auto flex w-full max-w-[1000px] flex-col items-center px-5 pb-28 text-center\"><h1 class=\"text-4xl font-semibold leading-tight md:text-5xl\">أفضل مولّد صور بالذكاء الاصطناعي</h1><p class=\"mt-5 text-sm leading-7 text-white/90 md:text-base md:leading-8\">حوّل الوصف النصي إلى صور عالية الجودة بأحدث نماذج الصور، ثم حرّكها إلى فيديو بنقرة واحدة.</p><form class=\"glass mt-8 flex w-full max-w-2xl items-center gap-3 rounded-full py-2 ps-7 pe-2\" action=\"/ar/signup\"><input maxLength=\"1000\" placeholder=\"صِف الصورة التي تريدها\" class=\"min-w-0 flex-1 bg-transparent py-2.5 text-sm outline-none placeholder:text-white/60\" name=\"prompt\"/><button class=\"btn btn-white\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"><path d=\"M12 3l2 6 6 2-6 2-2 6-2-6-6-2 6-2zM19 3v4M17 5h4\"></path></svg>إنشاء</button></form></div></section><section class=\"section\"><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">كيف تنشئ فيديوهات بالذكاء الاصطناعي</h2><p class=\"mt-4 max-w-3xl text-muted\">أدوات البرزة سهلة بطبيعتها، تحوّل أفكارك إلى مقاطع متحركة ومشاهد سينمائية. سواء بدأت بوصف أو بصور أو بفكرة أولية، تعرض لك هذه الخطوات كيف تحوّلها إلى فيديو معبّر.</p><div class=\"mt-6\"><a class=\"btn btn-gold\" href=\"/ar/signup\">ابدأ الإبداع</a></div><div class=\"mt-12 grid gap-8 md:grid-cols-3\"><div><h3 class=\"font-semibold\"><span class=\"text-gold\">1<!-- -->.</span> <!-- -->افتح أداة الفيديو</h3><p class=\"mt-2 text-sm leading-6 text-muted\">افتح أداة الفيديو في البرزة، ثم اختر البدء من وصف أو صورة أو فكرة تتخيلها، مع إمكانية رفع صور مرجعية.</p><img src=\"/media/gallery-2.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"mt-5 h-60 w-full rounded-2xl border border-line object-cover\"/></div><div><h3 class=\"font-semibold\"><span class=\"text-gold\">2<!-- -->.</span> <!-- -->اختر نموذج الفيديو</h3><p class=\"mt-2 text-sm leading-6 text-muted\">اختر نموذج الفيديو المناسب، ثم حدد نسبة العرض والمدة والدقة، مع إطار بداية ونهاية اختياريين.</p><img src=\"/media/gallery-3.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"mt-5 h-60 w-full rounded-2xl border border-line object-cover\"/></div><div><h3 class=\"font-semibold\"><span class=\"text-gold\">3<!-- -->.</span> <!-- -->أنشئ وحسّن النتائج</h3><p class=\"mt-2 text-sm leading-6 text-muted\">احصل على فيديو جديد خلال ثوانٍ، ثم حمّله أو عدّل الوصف قليلاً وكرر العملية حتى تصل للنتيجة.</p><img src=\"/media/gallery-4.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"mt-5 h-60 w-full rounded-2xl border border-line object-cover\"/></div></div></section><section class=\"section pt-0\"><div class=\"grid gap-4 md:grid-cols-2\"><article class=\"card flex overflow-hidden\"><img src=\"/media/gallery-6.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"hidden h-auto w-40 shrink-0 object-cover sm:block\"/><div class=\"p-6\"><h3 class=\"font-semibold\">إعادة إنشاء بنقرة واحدة</h3><p class=\"mt-2 text-sm leading-6 text-muted\">أعد إنتاج المقاطع الرائجة أو المشاهد الشهيرة بأسلوب جديد؛ يلتقط الذكاء الاصطناعي الأسلوب والبنية والفكرة فتوفّر ساعات من المونتاج.</p></div></article><article class=\"card flex overflow-hidden\"><img src=\"/media/gallery-7.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"hidden h-auto w-40 shrink-0 object-cover sm:block\"/><div class=\"p-6\"><h3 class=\"font-semibold\">دقة على مستوى الإطار</h3><p class=\"mt-2 text-sm leading-6 text-muted\">وجّه كل لقطة بصور مرجعية وتحكم بالكاميرا؛ تبقى التركيبة والحركة والتفاصيل كما خططت تماماً.</p></div></article><article class=\"card flex overflow-hidden\"><img src=\"/media/gallery-8.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"hidden h-auto w-40 shrink-0 object-cover sm:block\"/><div class=\"p-6\"><h3 class=\"font-semibold\">سرد متعدد الكاميرات</h3><p class=\"mt-2 text-sm leading-6 text-muted\">انتقل بين الزوايا والمشاهد مع ثبات الشخصيات والمنتجات والأسلوب من لقطة إلى أخرى.</p></div></article><article class=\"card flex overflow-hidden\"><img src=\"/media/gallery-9.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"hidden h-auto w-40 shrink-0 object-cover sm:block\"/><div class=\"p-6\"><h3 class=\"font-semibold\">مشاهد حركة عالية التأثير</h3><p class=\"mt-2 text-sm leading-6 text-muted\">أنشئ حركة سريعة وديناميكية — مطاردات وحشود وحركات كاميرا واسعة — من وصف واحد.</p></div></article></div></section><section class=\"py-20\"><div class=\"mx-auto max-w-[1200px] px-5 text-center\"><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">أنشئ أي شيء تريده بمجموعة أدوات البرزة</h2><p class=\"mx-auto mt-4 max-w-2xl text-muted\">مساحة عمل واحدة لتوليد الفيديو والصور والصوت، لتنفّذ أكبر مشاريعك الإبداعية دون التنقل بين الأدوات.</p></div><div class=\"noscroll mt-10 flex snap-x gap-5 overflow-x-auto px-5\"><article class=\"relative h-[440px] w-[78vw] max-w-[640px] shrink-0 snap-center overflow-hidden rounded-3xl border border-line\"><img src=\"/media/gallery-1.svg\" alt=\"\" width=\"400\" height=\"500\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"glass absolute inset-x-4 bottom-4 flex items-center justify-between rounded-2xl p-4\"><h3 class=\"font-semibold\">الفيديو</h3><a class=\"btn btn-white !py-1.5\" href=\"/ar/signup\">جرّب الأداة</a></div></article><article class=\"relative h-[440px] w-[78vw] max-w-[640px] shrink-0 snap-center overflow-hidden rounded-3xl border border-line\"><img src=\"/media/gallery-2.svg\" alt=\"\" width=\"400\" height=\"500\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"glass absolute inset-x-4 bottom-4 flex items-center justify-between rounded-2xl p-4\"><h3 class=\"font-semibold\">الصور</h3><a class=\"btn btn-white !py-1.5\" href=\"/ar/signup\">جرّب الأداة</a></div></article><article class=\"relative h-[440px] w-[78vw] max-w-[640px] shrink-0 snap-center overflow-hidden rounded-3xl border border-line\"><img src=\"/media/gallery-3.svg\" alt=\"\" width=\"400\" height=\"500\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"glass absolute inset-x-4 bottom-4 flex items-center justify-between rounded-2xl p-4\"><h3 class=\"font-semibold\">مزامنة الشفاه</h3><a class=\"btn btn-white !py-1.5\" href=\"/ar/signup\">جرّب الأداة</a></div></article><article class=\"relative h-[440px] w-[78vw] max-w-[640px] shrink-0 snap-center overflow-hidden rounded-3xl border border-line\"><img src=\"/media/gallery-4.svg\" alt=\"\" width=\"400\" height=\"500\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"glass absolute inset-x-4 bottom-4 flex items-center justify-between rounded-2xl p-4\"><h3 class=\"font-semibold\">رفع الدقة</h3><a class=\"btn btn-white !py-1.5\" href=\"/ar/signup\">جرّب الأداة</a></div></article><article class=\"relative h-[440px] w-[78vw] max-w-[640px] shrink-0 snap-center overflow-hidden rounded-3xl border border-line\"><img src=\"/media/gallery-5.svg\" alt=\"\" width=\"400\" height=\"500\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"glass absolute inset-x-4 bottom-4 flex items-center justify-between rounded-2xl p-4\"><h3 class=\"font-semibold\">نص إلى صوت</h3><a class=\"btn btn-white !py-1.5\" href=\"/ar/signup\">جرّب الأداة</a></div></article><article class=\"relative h-[440px] w-[78vw] max-w-[640px] shrink-0 snap-center overflow-hidden rounded-3xl border border-line\"><img src=\"/media/gallery-6.svg\" alt=\"\" width=\"400\" height=\"500\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"glass absolute inset-x-4 bottom-4 flex items-center justify-between rounded-2xl p-4\"><h3 class=\"font-semibold\">تغيير الصوت</h3><a class=\"btn btn-white !py-1.5\" href=\"/ar/signup\">جرّب الأداة</a></div></article></div></section><section class=\"section max-w-3xl\"><div class=\"text-center\"><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">الأسئلة الشائعة</h2></div><div class=\"mt-10 divide-y divide-line border-y border-line\"><details class=\"group py-5\" open=\"\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">ما هو مولّد الفيديو في البرزة؟<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">يحوّل مولّد الفيديو في البرزة الوصف النصي والصور إلى مقاطع فيديو قصيرة، ويتيح لك مقارنة عدة نماذج في مساحة عمل واحدة. ابدأ بوصف واضح، وأنشئ نتيجة أولى، ثم حسّن التفصيل الذي يحتاج إلى تعديل.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">كيف أنشئ فيديو من صورة؟<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">ارفع إحدى صورك أو اختر صورة من جلساتك السابقة، ثم أضف وصفاً نصياً وعدّل الإعدادات واضغط إنشاء. يحيي المولّد صورتك وفق تعليماتك، ويمكنك التحكم بالحركة عبر الإطارين الأول والأخير لكل مقطع. يكفي عادةً وصف قصير ومحدد لنتيجة أولى نظيفة.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">هل يمكنني استخدام الفيديوهات المُولَّدة في مشاريع تجارية؟<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">نعم، بشرط الالتزام بشروط استخدام البرزة وقوانين دولة الإمارات. يدعم المولّد أعمال العملاء ومحتوى التواصل الاجتماعي والإعلانات والحملات التسويقية.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">ما الحقوق التي أملكها على الفيديوهات المُولَّدة؟<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">تحتفظ بكامل حقوقك على الفيديوهات التي تنشئها، ويمكنك استخدامها وتعديلها وتوزيعها وتحقيق دخل منها وفق الترخيص وشروط الاستخدام. لا تدّعي البرزة ملكية المحتوى الذي تولّده.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">هل تُستخدم مخرجاتي لتدريب نماذج الذكاء الاصطناعي؟<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">لا. لا تستخدم البرزة أوصافك أو ملفاتك المرفوعة أو فيديوهاتك المُولَّدة لتدريب النماذج، وجميع المخرجات خاصة ومحمية وفق معايير أمنية صارمة وقانون حماية البيانات الشخصية الإماراتي.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">ما نماذج الفيديو المتاحة؟<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">تشمل قائمة النماذج حالياً Seedance وVeo وKling وWan وSora وغيرها. قارن المدة والدقة ودعم الصوت وتكلفة الأرصدة، ثم جرّب الوصف نفسه في نموذجين.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">كيف أكتب وصفاً لفيديو بالذكاء الاصطناعي؟<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">صِف الموضوع والحركة والمكان وحجم اللقطة وحركة الكاميرا والإضاءة. مثال: «دراجة حمراء تسير على طريق ساحلي عند الشروق، لقطة جانبية متتبّعة، ضوء ذهبي ناعم». راجع المقطع وعدّل تفصيل الحركة أو التأطير الذي لم يطابق ما تريد.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">هل يمكنني تحويل صورة إلى فيديو؟<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">نعم. أضف الصورة كإطار بداية في مساحة الفيديو، وصِف حركة العنصر واتجاه الكاميرا، واختر النموذج. راجع المعاينة والإعدادات قبل الإنشاء ثم افحص المقطع بحثاً عن تغييرات في العنصر.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">كيف تُحتسب تكلفة التوليد؟<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">تعرض البرزة تكلفة الأرصدة قبل الإنشاء. اختر النموذج والإعدادات، وراجع المبلغ المعروض، ثم أكّد قبل إرسال الطلب. الأسعار بالدرهم الإماراتي شاملة ضريبة القيمة المضافة.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">كيف أختار بين نماذج الفيديو؟<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">استخدم الوصف والنسبة والصورة المصدر نفسها في نموذجين وقارن جودة الحركة وثبات العنصر ودعم الصوت والمدة والدقة والتكلفة. اختر المخرج المناسب للقناة النهائية لا الأطول في المواصفات.</p></details></div></section><section class=\"relative overflow-hidden py-28 text-center\"><img src=\"/media/hero.svg\" alt=\"\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover opacity-60\"/><div class=\"relative\"><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">صمّم مع البرزة</h2><p class=\"mt-3 text-white/80\">أبدع بزخم. حوّل رؤيتك إلى واقع.</p><div class=\"mt-8\"><a class=\"btn btn-gold\" href=\"/ar/signup\">إنشاء حساب</a></div></div></section></main><!--$--><!--/$--><footer class=\"border-t border-line\"><div class=\"mx-auto max-w-[1200px] px-5 py-16\"><a class=\"flex items-center gap-2.5\" href=\"/ar\"><img src=\"/brand/logo.svg\" alt=\"\" width=\"26\" height=\"32\"/><span class=\"text-lg font-bold tracking-wide\">البرزة</span></a><div class=\"mt-12 grid grid-cols-2 gap-10 md:grid-cols-4\"><div><h4 class=\"mb-4 text-sm font-semibold\">النماذج</h4><ul class=\"space-y-2.5 text-sm text-muted\"><li><a class=\"hover:text-white\" href=\"/ar/video-generator/sora-2\">Sora 2</a></li><li><a class=\"hover:text-white\" href=\"/ar/video-generator/sora-2-pro\">Sora 2 Pro</a></li><li><a class=\"hover:text-white\" href=\"/ar/video-generator/veo-3-1\">Veo 3.1</a></li><li><a class=\"hover:text-white\" href=\"/ar/video-generator/veo-3-1-fast\">Veo 3.1 Fast</a></li><li><a class=\"hover:text-white\" href=\"/ar/video-generator/seedance-2-5\">Seedance 2.5</a></li><li><a class=\"hover:text-white\" href=\"/ar/video-generator/seedance-2-0\">Seedance 2.0</a></li><li><a class=\"hover:text-white\" href=\"/ar/video-generator/kling-o3\">Kling O3</a></li></ul></div><div><h4 class=\"mb-4 text-sm font-semibold\">الميزات</h4><ul class=\"space-y-2.5 text-sm text-muted\"><li><a class=\"hover:text-white\" href=\"/ar/signup\">مولّد الفيديو</a></li><li><a class=\"hover:text-white\" href=\"/ar/image-generator\">صور الذكاء الاصطناعي</a></li><li><a class=\"hover:text-white\" href=\"/ar/signup\">رفع الدقة</a></li><li><a class=\"hover:text-white\" href=\"/ar/signup\">مزامنة الشفاه</a></li><li><a class=\"hover:text-white\" href=\"/ar/signup\">نص إلى صوت</a></li><li><a class=\"hover:text-white\" href=\"/ar/signup\">تغيير الصوت</a></li></ul></div><div><h4 class=\"mb-4 text-sm font-semibold\">الشركة</h4><ul class=\"space-y-2.5 text-sm text-muted\"><li><a class=\"hover:text-white\" href=\"/ar/pricing\">الأسعار</a></li><li><a class=\"hover:text-white\" href=\"/ar/help\">مركز المساعدة</a></li><li><a class=\"hover:text-white\" href=\"/ar/privacy\">سياسة الخصوصية</a></li><li><a class=\"hover:text-white\" href=\"/ar/refund\">الاسترجاع</a></li><li><a class=\"hover:text-white\" href=\"/ar/cookies\">ملفات الارتباط</a></li><li><a class=\"hover:text-white\" href=\"/ar/terms\">شروط الاستخدام</a></li><li><a class=\"hover:text-white\" href=\"/ar/contact\">تواصل معنا</a></li></ul></div><div><h4 class=\"mb-4 text-sm font-semibold\">تواصل اجتماعي</h4><ul class=\"space-y-2.5 text-sm text-muted\"><li><a class=\"hover:text-white\" href=\"#\">Instagram</a></li><li><a class=\"hover:text-white\" href=\"#\">X</a></li><li><a class=\"hover:text-white\" href=\"#\">TikTok</a></li><li><a class=\"hover:text-white\" href=\"#\">YouTube</a></li></ul></div></div><p class=\"mt-14 text-xs text-muted\">صُنع في دولة الإمارات العربية المتحدة. ملتزمون بالمرسوم بقانون اتحادي رقم ٤٥ لسنة ٢٠٢١ بشأن حماية البيانات الشخصية.</p><p class=\"mt-3 text-xs text-muted/70\">البرزة منتج مستقل. أسماء النماذج والعلامات التجارية لأطراف ثالثة تعود لأصحابها، والإشارة إليها لا تعني شراكة أو تزكية.</p><p class=\"mt-6 text-xs text-muted\">© <!-- -->2026<!-- --> <!-- -->البرزة<!-- -->. <!-- -->جميع الحقوق محفوظة<!-- -->.</p></div></footer><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/1x6obpmlu1_c2.js\",\"static/chunks/2r4s4h5xul1n-.js\",\"static/chunks/3wbm-994r45kr.js\",\"static/chunks/2e268anpfvdoc.js\"],\"runtimeModuleIds\":[94553]});</script><script src=\"/_next/static/chunks/1x6obpmlu1_c2.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</scr