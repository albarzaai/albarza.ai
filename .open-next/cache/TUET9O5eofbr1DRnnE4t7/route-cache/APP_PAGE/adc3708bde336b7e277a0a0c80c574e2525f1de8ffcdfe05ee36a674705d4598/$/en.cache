{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/(site)/layout,_N_T_/[locale]/(site)/page,_N_T_/en"},"segmentPaths":["/_tree","/_full","/$d$locale/!KHNpdGUp/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/adc3708bde336b7e277a0a0c80c574e2525f1de8ffcdfe05ee36a674705d4598/$/en","owner":{"kind":"APP_PAGE","sourceRoute":"/[locale]/(site)/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"en\" dir=\"ltr\" class=\"_0bjUvq_variable hHfarW_variable\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/07c7676b89ed2778-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/f5e6f786bcaa2be4-s.p.30d2r2x65bwdm.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/media/hero.svg\" as=\"image\" fetchPriority=\"high\"/><link rel=\"preload\" href=\"/brand/logo.svg\" as=\"image\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/17tymn_qegvh9.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1x6obpmlu1_c2.js\"/><script src=\"/_next/static/chunks/2r4s4h5xul1n-.js\" async=\"\"></script><script src=\"/_next/static/chunks/3wbm-994r45kr.js\" async=\"\"></script><script src=\"/_next/static/chunks/2e268anpfvdoc.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3-ry682tkyiqk.js\" async=\"\"></script><script src=\"/_next/static/chunks/0umf92h1sb77c.js\" async=\"\"></script><script src=\"/_next/static/chunks/2n5qeheznvl4u.js\" async=\"\"></script><script src=\"/_next/static/chunks/1_miqk4gqcfj7.js\" async=\"\"></script><title>Albarza — The best AI video generator for creators</title><meta name=\"description\" content=\"Create cinematic, high quality videos from text prompts or image references using industry leading AI models.\"/><link rel=\"icon\" href=\"/brand/logo.svg\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><header class=\"absolute inset-x-0 top-0 z-40\"><div class=\"flex h-[76px] items-center justify-between px-5 md:px-10\"><div class=\"flex items-center gap-12\"><a class=\"flex items-center gap-2.5\" href=\"/en\"><img src=\"/brand/logo.svg\" alt=\"\" width=\"26\" height=\"32\"/><span class=\"text-lg font-bold tracking-wide\">Albarza</span></a><nav class=\"hidden items-center gap-8 text-sm font-medium lg:flex\"><a class=\"flex items-center gap-1 hover:text-gold-hi\" href=\"/en/image-generator\">AI Image<svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\"></path></svg></a><a class=\"flex items-center gap-1 hover:text-gold-hi\" href=\"/en/video-generator/veo-3-1\">AI Video<svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\"></path></svg></a><a class=\"flex items-center gap-1 hover:text-gold-hi\" href=\"/en/signup\">AI Editor</a><a class=\"flex items-center gap-1 hover:text-gold-hi\" href=\"/en/signup\">Explore</a><a class=\"flex items-center gap-1 hover:text-gold-hi\" href=\"/en/signup\">Templates</a></nav></div><div class=\"flex items-center gap-5 text-sm font-medium\"><a hrefLang=\"ar\" class=\"text-white/80 hover:text-white\" href=\"/ar\">العربية</a><a class=\"hidden hover:text-gold-hi sm:block\" href=\"/en/pricing\">Pricing</a><a class=\"hover:text-gold-hi\" href=\"/en/login\">Sign in</a><a class=\"btn btn-gold !px-6\" href=\"/en/signup\">Sign Up</a></div></div></header><main><section class=\"relative flex min-h-[100svh] items-end justify-center overflow-hidden\"><img src=\"/media/hero.svg\" alt=\"\" fetchPriority=\"high\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/70\"></div><nav aria-label=\"breadcrumb\" class=\"absolute start-10 top-[112px] z-10 hidden text-sm text-white/80 md:block\"><a href=\"/en\">Home</a> <span class=\"px-1\">/</span> <span class=\"text-white\">Video Generator</span></nav><div class=\"relative z-10 mx-auto flex w-full max-w-[1000px] flex-col items-center px-5 pb-28 text-center\"><h1 class=\"text-4xl font-semibold leading-tight md:text-5xl\">The best AI video generator for creators</h1><p class=\"mt-5 text-sm leading-7 text-white/90 md:text-base md:leading-8\">Whether you want to turn a text prompt into a cinematic scene, bring a still photo to life with motion, or direct a shot frame by frame, Albarza is the video generator made for it. It puts the newest video models, including Veo 3.1, Kling, and Seedance, in a single workspace, so creators can match the right model to each shot and produce professional-grade motion without piecing together separate tools. Describe your scene, add visual guidance, and generate videos that stay true to your creative vision.</p><form class=\"glass mt-8 flex w-full max-w-2xl items-center gap-3 rounded-full py-2 ps-7 pe-2\" action=\"/en/signup\"><input maxLength=\"1000\" placeholder=\"Describe your video\" class=\"min-w-0 flex-1 bg-transparent py-2.5 text-sm outline-none placeholder:text-white/60\" name=\"prompt\"/><button class=\"btn btn-white\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"><path d=\"M12 3l2 6 6 2-6 2-2 6-2-6-6-2 6-2zM19 3v4M17 5h4\"></path></svg>Generate</button></form></div></section><section class=\"section text-center\"><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">Access all leading AI video generation models</h2><p class=\"mx-auto mt-4 max-w-2xl text-muted\">Create any video using industry-leading text-to-video and image-to-video AI models — all in one powerful platform built for creators.</p><div class=\"mt-6\"><a class=\"btn btn-gold\" href=\"/en/signup\">Start Creating</a></div><div class=\"relative mt-12 min-h-[520px] overflow-hidden rounded-3xl border border-line text-start\"><img src=\"/media/hero.svg\" alt=\"\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"glass relative m-5 max-w-sm rounded-2xl p-6\"><p class=\"mb-4 text-sm font-semibold\">AI Video</p><ul class=\"space-y-1\"><li><button class=\"w-full rounded-lg px-3 py-1.5 text-start text-sm transition bg-white/10 text-gold-hi\">Sora 2</button></li><li><button class=\"w-full rounded-lg px-3 py-1.5 text-start text-sm transition text-white/70 hover:text-white\">Sora 2 Pro</button></li><li><button class=\"w-full rounded-lg px-3 py-1.5 text-start text-sm transition text-white/70 hover:text-white\">Veo 3.1</button></li><li><button class=\"w-full rounded-lg px-3 py-1.5 text-start text-sm transition text-white/70 hover:text-white\">Veo 3.1 Fast</button></li><li><button class=\"w-full rounded-lg px-3 py-1.5 text-start text-sm transition text-white/70 hover:text-white\">Seedance 2.5</button></li><li><button class=\"w-full rounded-lg px-3 py-1.5 text-start text-sm transition text-white/70 hover:text-white\">Seedance 2.0</button></li><li><button class=\"w-full rounded-lg px-3 py-1.5 text-start text-sm transition text-white/70 hover:text-white\">Kling O3</button></li><li><button class=\"w-full rounded-lg px-3 py-1.5 text-start text-sm transition text-white/70 hover:text-white\">Kling 2.6 Pro</button></li><li><button class=\"w-full rounded-lg px-3 py-1.5 text-start text-sm transition text-white/70 hover:text-white\">Grok Imagine Video</button></li><li><button class=\"w-full rounded-lg px-3 py-1.5 text-start text-sm transition text-white/70 hover:text-white\">Wan 2.6</button></li><li><button class=\"w-full rounded-lg px-3 py-1.5 text-start text-sm transition text-white/70 hover:text-white\">Seedance 1.5 Pro</button></li></ul><p class=\"mt-5 border-t border-white/10 pt-4 text-xs leading-6 text-white/80\">High-end text-to-video model focused on realism and storytelling, creating detailed scenes with smooth, coherent motion.</p><a class=\"btn btn-gold mt-4 w-full\" href=\"/en/signup\">Try the tool</a></div></div></section><section class=\"section\"><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">How to generate AI videos</h2><p class=\"mt-4 max-w-3xl text-muted\">Albarza&#x27;s tools are intuitive by design, making it easy to create standout animated clips and cinematic visuals. Whether you start from a prompt, your photos, or just something sketched out, these steps show how to turn it into finished video.</p><div class=\"mt-6\"><a class=\"btn btn-gold\" href=\"/en/signup\">Start Creating</a></div><div class=\"mt-12 grid gap-8 md:grid-cols-3\"><div><h3 class=\"font-semibold\"><span class=\"text-gold\">1<!-- -->.</span> <!-- -->Go to the video tool</h3><p class=\"mt-2 text-sm leading-6 text-muted\">Open the Albarza video tool, then choose to start from a prompt, a photo, or an idea, with optional reference images.</p><img src=\"/media/gallery-2.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"mt-5 h-60 w-full rounded-2xl border border-line object-cover\"/></div><div><h3 class=\"font-semibold\"><span class=\"text-gold\">2<!-- -->.</span> <!-- -->Choose your video model</h3><p class=\"mt-2 text-sm leading-6 text-muted\">Pick an AI video model, then set your aspect ratio, resolution and duration, with optional start and end frames.</p><img src=\"/media/gallery-3.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"mt-5 h-60 w-full rounded-2xl border border-line object-cover\"/></div><div><h3 class=\"font-semibold\"><span class=\"text-gold\">3<!-- -->.</span> <!-- -->Generate and refine your results</h3><p class=\"mt-2 text-sm leading-6 text-muted\">Get your new video in seconds, download it or tweak the prompt a little and iterate until it&#x27;s right.</p><img src=\"/media/gallery-4.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"mt-5 h-60 w-full rounded-2xl border border-line object-cover\"/></div></div></section><section class=\"section pt-0\"><div class=\"grid gap-4 md:grid-cols-2\"><article class=\"card flex overflow-hidden\"><img src=\"/media/gallery-6.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"hidden h-auto w-40 shrink-0 object-cover sm:block\"/><div class=\"p-6\"><h3 class=\"font-semibold\">One-Click Video Recreation</h3><p class=\"mt-2 text-sm leading-6 text-muted\">Recreate trending clips or reimagine iconic scenes — the AI captures style, structure, and intent, so you skip hours of manual editing.</p></div></article><article class=\"card flex overflow-hidden\"><img src=\"/media/gallery-7.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"hidden h-auto w-40 shrink-0 object-cover sm:block\"/><div class=\"p-6\"><h3 class=\"font-semibold\">Frame-Level Precision</h3><p class=\"mt-2 text-sm leading-6 text-muted\">Guide every shot with reference images and camera controls — composition, motion, and detail stay exactly on brief.</p></div></article><article class=\"card flex overflow-hidden\"><img src=\"/media/gallery-8.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"hidden h-auto w-40 shrink-0 object-cover sm:block\"/><div class=\"p-6\"><h3 class=\"font-semibold\">Multi-Camera Storytelling</h3><p class=\"mt-2 text-sm leading-6 text-muted\">Cut between angles and scenes while your characters, products, and style stay consistent shot to shot.</p></div></article><article class=\"card flex overflow-hidden\"><img src=\"/media/gallery-9.svg\" alt=\"\" width=\"400\" height=\"300\" loading=\"lazy\" class=\"hidden h-auto w-40 shrink-0 object-cover sm:block\"/><div class=\"p-6\"><h3 class=\"font-semibold\">High-Impact Motion Scenes</h3><p class=\"mt-2 text-sm leading-6 text-muted\">Create fast, dynamic action — chases, crowds, and sweeping camera moves — straight from a single prompt.</p></div></article></div></section><section class=\"section grid gap-12 lg:grid-cols-2\"><div><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">Why creators choose Albarza&#x27;s AI video generator</h2><p class=\"mt-4 max-w-md text-muted\">Get the fastest, most intuitive way to create professional videos using today&#x27;s leading AI video generation models, with camera control, preview and quick iteration.</p><div class=\"mt-6\"><a class=\"btn btn-gold\" href=\"/en/signup\">Start Creating</a></div></div><div class=\"space-y-3\"><div class=\"card p-5\"><h3 class=\"text-sm font-semibold\"><span class=\"text-gold\">›</span> <!-- -->Newest models first</h3><p class=\"mt-1.5 ps-4 text-xs leading-6 text-muted\">Access the latest video models, including Veo 3.1, Kling, and Seedance, in one workspace as soon as they launch.</p></div><div class=\"card p-5\"><h3 class=\"text-sm font-semibold\"><span class=\"text-gold\">›</span> <!-- -->Professional results, less time</h3><p class=\"mt-1.5 ps-4 text-xs leading-6 text-muted\">Generate polished clips with realistic motion, stable characters, and sharp detail.</p></div><div class=\"card p-5\"><h3 class=\"text-sm font-semibold\"><span class=\"text-gold\">›</span> <!-- -->Multiple ways to create</h3><p class=\"mt-1.5 ps-4 text-xs leading-6 text-muted\">Start with a simple prompt or animate a photo, with start and end frame control.</p></div><div class=\"card p-5\"><h3 class=\"text-sm font-semibold\"><span class=\"text-gold\">›</span> <!-- -->Built for speed and scale</h3><p class=\"mt-1.5 ps-4 text-xs leading-6 text-muted\">Produce concepts, storyboards, and ads faster and reduce production costs.</p></div><div class=\"card p-5\"><h3 class=\"text-sm font-semibold\"><span class=\"text-gold\">›</span> <!-- -->Create on your phone</h3><p class=\"mt-1.5 ps-4 text-xs leading-6 text-muted\">Studio-grade AI videos from mobile on the same account (coming soon).</p></div><div class=\"card p-5\"><h3 class=\"text-sm font-semibold\"><span class=\"text-gold\">›</span> <!-- -->All-in-one creative toolkit</h3><p class=\"mt-1.5 ps-4 text-xs leading-6 text-muted\">Video, image, and voiceover creation in a single workspace.</p></div></div></section><section class=\"section pt-0\"><div class=\"relative overflow-hidden rounded-3xl border border-line px-6 py-20 text-center\"><img src=\"/media/hero.svg\" alt=\"\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover opacity-70\"/><div class=\"relative\"><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">Try Veo 3.1</h2><p class=\"mx-auto mt-4 max-w-xl text-white/80\">Enter a prompt or upload a reference image, and Veo 3.1 turns your idea into cinematic, finished video.</p><div class=\"mt-6\"><a class=\"btn btn-gold\" href=\"/en/signup\">Start Creating</a></div></div></div></section><section class=\"py-20\"><div class=\"mx-auto max-w-[1200px] px-5 text-center\"><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">Create anything you want with Albarza&#x27;s toolkit</h2><p class=\"mx-auto mt-4 max-w-2xl text-muted\">One workspace for video, image and voice generation — so you can take on your biggest creative projects without switching tools.</p></div><div class=\"noscroll mt-10 flex snap-x gap-5 overflow-x-auto px-5\"><article class=\"relative h-[440px] w-[78vw] max-w-[640px] shrink-0 snap-center overflow-hidden rounded-3xl border border-line\"><img src=\"/media/gallery-1.svg\" alt=\"\" width=\"400\" height=\"500\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"glass absolute inset-x-4 bottom-4 flex items-center justify-between rounded-2xl p-4\"><h3 class=\"font-semibold\">Video</h3><a class=\"btn btn-white !py-1.5\" href=\"/en/signup\">Try the tool</a></div></article><article class=\"relative h-[440px] w-[78vw] max-w-[640px] shrink-0 snap-center overflow-hidden rounded-3xl border border-line\"><img src=\"/media/gallery-2.svg\" alt=\"\" width=\"400\" height=\"500\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"glass absolute inset-x-4 bottom-4 flex items-center justify-between rounded-2xl p-4\"><h3 class=\"font-semibold\">Image</h3><a class=\"btn btn-white !py-1.5\" href=\"/en/signup\">Try the tool</a></div></article><article class=\"relative h-[440px] w-[78vw] max-w-[640px] shrink-0 snap-center overflow-hidden rounded-3xl border border-line\"><img src=\"/media/gallery-3.svg\" alt=\"\" width=\"400\" height=\"500\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"glass absolute inset-x-4 bottom-4 flex items-center justify-between rounded-2xl p-4\"><h3 class=\"font-semibold\">Lip-sync</h3><a class=\"btn btn-white !py-1.5\" href=\"/en/signup\">Try the tool</a></div></article><article class=\"relative h-[440px] w-[78vw] max-w-[640px] shrink-0 snap-center overflow-hidden rounded-3xl border border-line\"><img src=\"/media/gallery-4.svg\" alt=\"\" width=\"400\" height=\"500\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"glass absolute inset-x-4 bottom-4 flex items-center justify-between rounded-2xl p-4\"><h3 class=\"font-semibold\">Upscale</h3><a class=\"btn btn-white !py-1.5\" href=\"/en/signup\">Try the tool</a></div></article><article class=\"relative h-[440px] w-[78vw] max-w-[640px] shrink-0 snap-center overflow-hidden rounded-3xl border border-line\"><img src=\"/media/gallery-5.svg\" alt=\"\" width=\"400\" height=\"500\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"glass absolute inset-x-4 bottom-4 flex items-center justify-between rounded-2xl p-4\"><h3 class=\"font-semibold\">Text to Voice</h3><a class=\"btn btn-white !py-1.5\" href=\"/en/signup\">Try the tool</a></div></article><article class=\"relative h-[440px] w-[78vw] max-w-[640px] shrink-0 snap-center overflow-hidden rounded-3xl border border-line\"><img src=\"/media/gallery-6.svg\" alt=\"\" width=\"400\" height=\"500\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover\"/><div class=\"glass absolute inset-x-4 bottom-4 flex items-center justify-between rounded-2xl p-4\"><h3 class=\"font-semibold\">Voice Changer</h3><a class=\"btn btn-white !py-1.5\" href=\"/en/signup\">Try the tool</a></div></article></div></section><section class=\"section\"><div class=\"text-center\"><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">A community of creators</h2><p class=\"mx-auto mt-4 max-w-2xl text-muted\">Join a creative network where people generate AI images and videos, share ideas and inspire each other every day.</p></div><div class=\"mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3\"><figure class=\"card p-6\"><h3 class=\"font-semibold\">The only AI video generator I still use</h3><p class=\"mt-3 text-sm leading-6 text-muted\">I&#x27;ve tested nearly every text-to-video tool, and this one stuck. Prompts are interpreted the way I imagine them and motion looks smooth.</p><figcaption class=\"mt-5 flex items-center gap-3 text-sm\"><span class=\"grid h-9 w-9 place-items-center rounded-full bg-gold text-black\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"><path d=\"M12 3a3 3 0 013 3v6a3 3 0 01-6 0V6a3 3 0 013-3zM5 11a7 7 0 0014 0M12 18v3\"></path></svg></span>Content creator</figcaption></figure><figure class=\"card p-6\"><h3 class=\"font-semibold\">Image-to-video results that look cinematic</h3><p class=\"mt-3 text-sm leading-6 text-muted\">I animate product shots and concept art, and camera movement lands almost every time. Rendering is fast.</p><figcaption class=\"mt-5 flex items-center gap-3 text-sm\"><span class=\"grid h-9 w-9 place-items-center rounded-full bg-gold text-black\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"><path d=\"M12 3a3 3 0 013 3v6a3 3 0 01-6 0V6a3 3 0 013-3zM5 11a7 7 0 0014 0M12 18v3\"></path></svg></span>Product designer</figcaption></figure><figure class=\"card p-6\"><h3 class=\"font-semibold\">From idea to finished clip in minutes</h3><p class=\"mt-3 text-sm leading-6 text-muted\">I need short-form video daily, and this cut my production time seriously.</p><figcaption class=\"mt-5 flex items-center gap-3 text-sm\"><span class=\"grid h-9 w-9 place-items-center rounded-full bg-gold text-black\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"><path d=\"M12 3a3 3 0 013 3v6a3 3 0 01-6 0V6a3 3 0 013-3zM5 11a7 7 0 0014 0M12 18v3\"></path></svg></span>Social media manager</figcaption></figure><figure class=\"card p-6\"><h3 class=\"font-semibold\">An AI video tool my clients approve</h3><p class=\"mt-3 text-sm leading-6 text-muted\">We storyboard, generate and upscale entire video ads without touching a camera.</p><figcaption class=\"mt-5 flex items-center gap-3 text-sm\"><span class=\"grid h-9 w-9 place-items-center rounded-full bg-gold text-black\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"><path d=\"M12 3a3 3 0 013 3v6a3 3 0 01-6 0V6a3 3 0 013-3zM5 11a7 7 0 0014 0M12 18v3\"></path></svg></span>Ad director</figcaption></figure><figure class=\"card p-6\"><h3 class=\"font-semibold\">All the newest video models in one place</h3><p class=\"mt-3 text-sm leading-6 text-muted\">Instead of juggling three subscriptions, I compare outputs from the latest models side by side.</p><figcaption class=\"mt-5 flex items-center gap-3 text-sm\"><span class=\"grid h-9 w-9 place-items-center rounded-full bg-gold text-black\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"><path d=\"M12 3a3 3 0 013 3v6a3 3 0 01-6 0V6a3 3 0 013-3zM5 11a7 7 0 0014 0M12 18v3\"></path></svg></span>Filmmaker</figcaption></figure><figure class=\"card p-6\"><h3 class=\"font-semibold\">Best value video generator</h3><p class=\"mt-3 text-sm leading-6 text-muted\">Realistic motion, clean audio sync, and exports that look sharp even on a big screen.</p><figcaption class=\"mt-5 flex items-center gap-3 text-sm\"><span class=\"grid h-9 w-9 place-items-center rounded-full bg-gold text-black\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"\" aria-hidden=\"true\"><path d=\"M12 3a3 3 0 013 3v6a3 3 0 01-6 0V6a3 3 0 013-3zM5 11a7 7 0 0014 0M12 18v3\"></path></svg></span>Digital marketer</figcaption></figure></div><p class=\"mt-4 text-center text-xs text-muted/60\">Sample copy — replace with real customer quotes before launch.</p></section><section class=\"section\"><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">Create on the go</h2><p class=\"mt-4 max-w-xl text-muted\">The full power of dozens of AI models in your pocket. Generate videos, images and audio from anywhere — no desktop required.</p><p class=\"mt-3 text-sm text-gold-hi\">iOS and Android apps coming soon.</p></section><section class=\"section max-w-3xl\"><div class=\"text-center\"><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">Key takeaways</h2></div><ul class=\"mt-8 space-y-3 text-sm leading-7 text-muted\"><li class=\"flex gap-3\"><span class=\"text-gold\">•</span>Best for mobile creators: Albarza generates studio-grade video directly on a phone.</li><li class=\"flex gap-3\"><span class=\"text-gold\">•</span>Best for photo-to-video: turn photos into cinematic clips with frame-by-frame control.</li><li class=\"flex gap-3\"><span class=\"text-gold\">•</span>Most models in one place: the newest video models in one workspace.</li><li class=\"flex gap-3\"><span class=\"text-gold\">•</span>All-in-one toolkit: video, image, and voice generation in a single workspace.</li></ul></section><section class=\"section max-w-3xl\"><div class=\"text-center\"><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">Frequently Asked Questions</h2></div><div class=\"mt-10 divide-y divide-line border-y border-line\"><details class=\"group py-5\" open=\"\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">What is Albarza&#x27;s AI video generator?<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">Albarza&#x27;s AI Video Generator turns text prompts and images into short video clips and lets you compare multiple video models in one workspace. Start with a clear brief, generate a first result, and refine the detail that needs improvement.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">How do I generate a video from an image?<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">Upload a photo or choose an image from your previous sessions, add a text prompt, adjust your settings, and click Generate. You can control the start and end frames of each clip. A short, specific prompt is usually enough for a clean first result.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">Can I use AI-generated videos in commercial projects?<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">Yes, as long as they comply with Albarza&#x27;s Terms of Use and UAE law. Use cases include client work, social media content, ads, and marketing campaigns.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">What rights do I have over AI-generated videos?<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">You keep full rights to the videos you create. You are free to use, modify, distribute, and monetize them, subject to the License and Terms of Use. Albarza does not claim ownership of your generated content.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">Are my video outputs used to train AI models?<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">No. Albarza does not use your prompts, uploads, or generated videos to train AI models. All outputs are private and protected under strict security standards and the UAE PDPL.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">What AI video models are available?<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">The model picker includes Seedance, Veo, Kling, Wan, Sora, and others. Compare duration, resolution, audio support, and credit cost, then test the same brief in two models.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">How do I write a prompt for an AI video?<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">Describe the subject, action, setting, shot size, camera movement, and lighting. Example: “A red bicycle rolls along a coastal road at sunrise; steady side-tracking shot, soft golden light.” Review the clip and revise the detail that missed your intent.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">Can I turn a photo into an AI video?<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">Yes. Add the photo as Start Image in the Video workspace, describe the subject&#x27;s movement and camera direction, and choose a model. Review the preview and settings before generating.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">How are AI video generations charged?<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">Albarza shows the credit cost before you generate. Select the model and settings, review the displayed amount, and confirm. Prices are in AED, inclusive of VAT.</p></details><details class=\"group py-5\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\">How do I choose between AI video models?<span class=\"text-gold transition group-open:rotate-45\">+</span></summary><p class=\"mt-3 text-sm leading-7 text-muted\">Use the same short prompt, aspect ratio, and source image in two models. Compare motion quality, subject consistency, audio support, duration, resolution, and cost. Choose the output that fits the final channel.</p></details></div></section><section class=\"relative overflow-hidden py-28 text-center\"><img src=\"/media/hero.svg\" alt=\"\" loading=\"lazy\" class=\"absolute inset-0 h-full w-full object-cover opacity-60\"/><div class=\"relative\"><h2 class=\"text-3xl font-semibold leading-tight md:text-[40px]\">Design with Albarza</h2><p class=\"mt-3 text-white/80\">Create with momentum. Bring your vision to life.</p><div class=\"mt-8\"><a class=\"btn btn-gold\" href=\"/en/signup\">Sign Up</a></div></div></section></main><!--$--><!--/$--><footer class=\"border-t border-line\"><div class=\"mx-auto max-w-[1200px] px-5 py-16\"><a class=\"flex items-center gap-2.5\" href=\"/en\"><img src=\"/brand/logo.svg\" alt=\"\" width=\"26\" height=\"32\"/><span class=\"text-lg font-bold tracking-wide\">Albarza</span></a><div class=\"mt-12 grid grid-cols-2 gap-10 md:grid-cols-4\"><div><h4 class=\"mb-4 text-sm font-semibold\">Models</h4><ul class=\"space-y-2.5 text-sm text-muted\"><li><a class=\"hover:text-white\" href=\"/en/video-generator/sora-2\">Sora 2</a></li><li><a class=\"hover:text-white\" href=\"/en/video-generator/sora-2-pro\">Sora 2 Pro</a></li><li><a class=\"hover:text-white\" href=\"/en/video-generator/veo-3-1\">Veo 3.1</a></li><li><a class=\"hover:text-white\" href=\"/en/video-generator/veo-3-1-fast\">Veo 3.1 Fast</a></li><li><a class=\"hover:text-white\" href=\"/en/video-generator/seedance-2-5\">Seedance 2.5</a></li><li><a class=\"hover:text-white\" href=\"/en/video-generator/seedance-2-0\">Seedance 2.0</a></li><li><a class=\"hover:text-white\" href=\"/en/video-generator/kling-o3\">Kling O3</a></li></ul></div><div><h4 class=\"mb-4 text-sm font-semibold\">Features</h4><ul class=\"space-y-2.5 text-sm text-muted\"><li><a class=\"hover:text-white\" href=\"/en/signup\">Video Generator</a></li><li><a class=\"hover:text-white\" href=\"/en/image-generator\">AI Image</a></li><li><a class=\"hover:text-white\" href=\"/en/signup\">Upscale</a></li><li><a class=\"hover:text-white\" href=\"/en/signup\">Lip-sync</a></li><li><a class=\"hover:text-white\" href=\"/en/signup\">Text to Voice</a></li><li><a class=\"hover:text-white\" href=\"/en/signup\">Voice Changer</a></li></ul></div><div><h4 class=\"mb-4 text-sm font-semibold\">Company</h4><ul class=\"space-y-2.5 text-sm text-muted\"><li><a class=\"hover:text-white\" href=\"/en/pricing\">Pricing</a></li><li><a class=\"hover:text-white\" href=\"/en/help\">Help Center</a></li><li><a class=\"hover:text-white\" href=\"/en/privacy\">Privacy Policy</a></li><li><a class=\"hover:text-white\" href=\"/en/refund\">Refund</a></li><li><a class=\"hover:text-white\" href=\"/en/cookies\">Cookies</a></li><li><a class=\"hover:text-white\" href=\"/en/terms\">Terms of Use</a></li><li><a class=\"hover:text-white\" href=\"/en/contact\">Contact us</a></li></ul></div><div><h4 class=\"mb-4 text-sm font-semibold\">Socials</h4><ul class=\"space-y-2.5 text-sm text-muted\"><li><a class=\"hover:text-white\" href=\"#\">Instagram</a></li><li><a class=\"hover:text-white\" href=\"#\">X</a></li><li><a class=\"hover:text-white\" href=\"#\">TikTok</a></li><li><a class=\"hover:text-white\" href=\"#\">YouTube</a></li></ul></div></div><p class=\"mt-14 text-xs text-muted\">Made in the UAE. Compliant with Federal Decree-Law No. 45 of 2021 on Personal Data Protection.</p><p class=\"mt-3 text-xs text-muted/70\">Albarza is an independent product. Third-party model names and trademarks belong to their respective owners; references do not imply partnership or endorsement.</p><p class=\"mt-6 text-xs text-muted\">© <!-- -->2026<!-- --> <!-- -->Albarza<!-- -->. <!-- -->All rights reserved<!-- -->.</p></div></footer><script id=\"_R_\">(globalThis[\"TURBOPACK\"] || (globalThis[\"TURBOPACK\"] = [])).push({\"otherChunks\":[\"static/chunks/1x6obpmlu1_c2.js\",\"static/chunks/2r4s4h5xul1n-.js\",\"static/chu