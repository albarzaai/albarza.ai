":\"mt-10 divide-y divide-line border-y border-line\",\"children\":[[\"$\",\"details\",\"What is Albarza's AI video generator?\",{\"className\":\"group py-5\",\"open\":true,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"ما هو مولّد الفيديو في البرزة؟\",[\"$\",\"span\",null,{\"className\":\"text-gold transition group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-7 text-muted\",\"children\":\"يحوّل مولّد الفيديو في البرزة الوصف النصي والصور إلى مقاطع فيديو قصيرة، ويتيح لك مقارنة عدة نماذج في مساحة عمل واحدة. ابدأ بوصف واضح، وأنشئ نتيجة أولى، ثم حسّن التفصيل الذي يحتاج إلى تعديل.\"}]]}],[\"$\",\"details\",\"How do I generate a video from an image?\",{\"className\":\"group py-5\",\"open\":false,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"كيف أنشئ فيديو من صورة؟\",[\"$\",\"span\",null,{\"className\":\"text-gold transition group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-7 text-muted\",\"children\":\"ارفع إحدى صورك أو اختر صورة من جلساتك السابقة، ثم أضف وصفاً نصياً وعدّل الإعدادات واضغط إنشاء. يحيي المولّد صورتك وفق تعليماتك، ويمكنك التحكم بالحركة عبر الإطارين الأول والأخير لكل مقطع. يكفي عادةً وصف قصير ومحدد لنتيجة أولى نظيفة.\"}]]}],[\"$\",\"details\",\"Can I use AI-generated videos in commercial projects?\",{\"className\":\"group py-5\",\"open\":false,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"هل يمكنني استخدام الفيديوهات المُولَّدة في مشاريع تجارية؟\",[\"$\",\"span\",null,{\"className\":\"text-gold transition group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-7 text-muted\",\"children\":\"نعم، بشرط الالتزام بشروط استخدام البرزة وقوانين دولة الإمارات. يدعم المولّد أعمال العملاء ومحتوى التواصل الاجتماعي والإعلانات والحملات التسويقية.\"}]]}],[\"$\",\"details\",\"What rights do I have over AI-generated videos?\",{\"className\":\"group py-5\",\"open\":false,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"ما الحقوق التي أملكها على الفيديوهات المُولَّدة؟\",[\"$\",\"span\",null,{\"className\":\"text-gold transition group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-7 text-muted\",\"children\":\"تحتفظ بكامل حقوقك على الفيديوهات التي تنشئها، ويمكنك استخدامها وتعديلها وتوزيعها وتحقيق دخل منها وفق الترخيص وشروط الاستخدام. لا تدّعي البرزة ملكية المحتوى الذي تولّده.\"}]]}],[\"$\",\"details\",\"Are my video outputs used to train AI models?\",{\"className\":\"group py-5\",\"open\":false,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"هل تُستخدم مخرجاتي لتدريب نماذج الذكاء الاصطناعي؟\",[\"$\",\"span\",null,{\"className\":\"text-gold transition group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-7 text-muted\",\"children\":\"لا. لا تستخدم البرزة أوصافك أو ملفاتك المرفوعة أو فيديوهاتك المُولَّدة لتدريب النماذج، وجميع المخرجات خاصة ومحمية وفق معايير أمنية صارمة وقانون حماية البيانات الشخصية الإماراتي.\"}]]}],[\"$\",\"details\",\"What AI video models are available?\",{\"className\":\"group py-5\",\"open\":false,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"ما نماذج الفيديو المتاحة؟\",\"$L2b\"]}],\"$L2c\"]}],\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\"]}]]}]\n2a:[\"$\",\"section\",null,{\"className\":\"relative overflow-hidden py-28 text-center\