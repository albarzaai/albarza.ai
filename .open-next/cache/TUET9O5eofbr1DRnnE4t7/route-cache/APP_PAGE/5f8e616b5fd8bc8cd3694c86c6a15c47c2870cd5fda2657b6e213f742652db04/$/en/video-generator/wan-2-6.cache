l,{\"className\":\"text-gold transition group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-7 text-muted\",\"children\":\"You keep full rights to the videos you create. You are free to use, modify, distribute, and monetize them, subject to the License and Terms of Use. Albarza does not claim ownership of your generated content.\"}]]}],[\"$\",\"details\",\"Are my video outputs used to train AI models?\",{\"className\":\"group py-5\",\"open\":false,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"Are my video outputs used to train AI models?\",[\"$\",\"span\",null,{\"className\":\"text-gold transition group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-7 text-muted\",\"children\":\"No. Albarza does not use your prompts, uploads, or generated videos to train AI models. All outputs are private and protected under strict security standards and the UAE PDPL.\"}]]}],[\"$\",\"details\",\"What AI video models are available?\",{\"className\":\"group py-5\",\"open\":false,\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium\",\"children\":[\"What AI video models are available?\",\"$L2b\"]}],\"$L2c\"]}],\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\"]}]]}]\n2a:[\"$\",\"section\",null,{\"className\":\"relative overflow-hidden py-28 text-center\",\"children\":[[\"$\",\"img\",null,{\"src\":\"/media/hero.svg\",\"alt\":\"\",\"loading\":\"lazy\",\"className\":\"absolute inset-0 h-full w-full object-cover opacity-60\"}],[\"$\",\"div\",null,{\"className\":\"relative\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-3xl font-semibold leading-tight md:text-[40px]\",\"children\":\"Design with Albarza\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-white/80\",\"children\":\"Create with momentum. Bring