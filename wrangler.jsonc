{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albarza-ai",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "albarza.ai", "custom_domain": true },
    { "pattern": "www.albarza.ai", "custom_domain": true }
  ],
  // Private link to the API Worker (api.albarza.ai). Secret INTERNAL_AUTH_SECRET is set with `wrangler secret put`.
  "services": [{ "binding": "API", "service": "albarza-api" }]
}
